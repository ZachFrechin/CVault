{
    "version": 3,
    "configurePresets": [
        {
            "name": "vcpkg-debug",
            "displayName": "Debug with vcpkg",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-vcpkg",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg-debug",
            "configurePreset": "vcpkg-debug"
        }
    ]
}
